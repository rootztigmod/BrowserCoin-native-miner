{
  "name": "browsercoin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "BrowserCoin — a cryptocurrency that lives in your browser. Open URL, get wallet, mine in your tab.",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode localhelpers",
    "build": "npm run build:native-miner && npm run build:headless-worker && tsc --noEmit && vite build",
    "build:native-miner": "cd native && RUSTFLAGS='-C target-cpu=native' cargo build --release -p browsercoin-native-miner",
    "build:headless-worker": "tsx tools/build-headless-worker.ts",
    "benchmark:headless": "tsx tools/benchmark-headless.ts",
    "benchmark:native": "tsx tools/benchmark-native.ts",
    "benchmark:native:sweep": "tsx tools/benchmark-native-sweep.ts",
    "test:native-miner": "tsx tools/verify-native-sandglass.ts",
    "mine:headless": "tsx tools/headless-miner.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:api": "tsx server/api.ts --port 9000",
    "server:peerjs": "tsx server/peerjs.ts --port 9001"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.5.0",
    "@types/qrcode": "^1.5.6",
    "argon2id": "^1.0.1",
    "jsqr": "^1.4.0",
    "peerjs": "^1.5.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "peer": "^1.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.5"
  }
}
